{
  "name": "@go-cms/admin-geo-yandex",
  "version": "0.1.0",
  "type": "module",
  "description": "Yandex geolocation field editor for Go CMS Admin",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@go-cms/admin": ">=0.8.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@go-cms/admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
